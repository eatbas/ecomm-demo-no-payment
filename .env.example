# JazzCash merchant profile — from the JazzCash portal, Integration > Credentials.
# Sandbox and production share the same field names; JazzCash's own guides print
# the same host for both, so the environment is selected by which credentials
# you put here, not by this URL (confirm the real production posture with
# JazzCash directly before go-live — see plan_request_claude.md's Risks section).
JAZZCASH_BASE_URL=https://onlinepayments.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_PASSWORD=your-merchant-password
JAZZCASH_INTEGRITY_SALT=your-integrity-salt
# Must be pre-registered with JazzCash and byte-identical on every request.
# The path must be exactly /checkout/return (server/routes/payments.ts).
JAZZCASH_RETURN_URL=https://your-deployed-domain.example/checkout/return
